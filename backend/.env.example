# NyayaMitra Backend Environment Variables
# Copy this to .env and fill in your actual keys

# ─── APP ───────────────────────────────────────────────
APP_NAME="NyayaMitra"
APP_ENV="development"           # development | production
BACKEND_URL="http://localhost:8000"
FRONTEND_URL="http://localhost:5173"
SECRET_KEY="REPLACE_WITH_32_CHAR_RANDOM_STRING"
DEBUG=true

# ─── DATABASE ──────────────────────────────────────────
DATABASE_URL="postgresql+asyncpg://nyayamitra:password@localhost:5432/nyayamitra"
DATABASE_URL_SYNC="postgresql://nyayamitra:password@localhost:5432/nyayamitra"

# ─── VECTOR DB ─────────────────────────────────────────
CHROMA_HOST="localhost"
CHROMA_PORT=8001
CHROMA_PERSIST_DIR="./data/chroma"

# ─── AI / LLM ──────────────────────────────────────────
GROQ_API_KEY="gsk_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
GROQ_MODEL="llama-3.3-70b-versatile"
GROQ_VISION_MODEL="llama-3.2-11b-vision-preview"

OPENAI_API_KEY="sk-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# ─── VOICE ─────────────────────────────────────────────
SARVAM_API_KEY="sk-XXXXXXXXXXXXXXXXXXXXXX"
SARVAM_STT_URL="https://api.sarvam.ai/speech-to-text"
SARVAM_TTS_URL="https://api.sarvam.ai/text-to-speech"

# ─── NOTIFICATIONS ─────────────────────────────────────
FCM_SERVER_KEY="AAAA_XXXXX"

# ─── WHATSAPP ──────────────────────────────────────────
WHATSAPP_TOKEN="EAXXXXXXXXXX"
WHATSAPP_PHONE_ID="XXXXXXXX"
WHATSAPP_WEBHOOK_VERIFY_TOKEN="nyayamitra_webhook_secret"

# ─── BLOCKCHAIN ────────────────────────────────────────
POLYGON_RPC_URL="https://polygon-rpc.com"
POLYGON_PRIVATE_KEY="0xXXXXXXXXXXXXXX"

# ─── SCRAPER SETTINGS ──────────────────────────────────
GAZETTE_SCRAPE_INTERVAL_HOURS=12
INDIA_CODE_BASE_URL="https://www.indiacode.nic.in"
EGAZETTE_BASE_URL="https://egazette.gov.in"
